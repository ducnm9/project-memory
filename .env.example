# HTTP listen port (positive integer). Default: 3000
PORT=3000
# Bind address. Default: 0.0.0.0
HOST=0.0.0.0
# One of: development | production | test. Default: development
NODE_ENV=development
# Pino log level (e.g. info, debug, warn, error). Default: info
LOG_LEVEL=info
# MongoDB connection string (required). e.g. mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017
# MongoDB database name (required).
MONGODB_DB_NAME=project_memory
# Admin bootstrap key gating org creation and token management (required in production).
AUTH_ADMIN_KEY=
# Server-side pepper for HMAC-SHA-256 token hashing (required in production).
AUTH_TOKEN_PEPPER=
# AES-256-GCM key for encrypting connector credentials at rest (required in production).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=
